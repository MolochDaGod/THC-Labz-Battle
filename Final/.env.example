# Database Configuration
DATABASE_URL=postgresql://username:password@hostname:port/database

# OpenAI API for AI Assistant
OPENAI_API_KEY=sk-...

# Helius API for enhanced blockchain data
HELIUS_PROJECT_ID=your-helius-project-id

# Discord OAuth (optional)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=https://your-app-domain.replit.app/auth/discord/callback

# CRITICAL: Solana Wallet Configuration
# These MUST be set for the application to function properly
# NEVER commit actual wallet addresses or secrets to git

# AI Agent Wallet - Main wallet address for processing rewards and swaps
# Alternative names supported for backward compatibility:
#   AI_AGENT_WALLET_ADDRESS (recommended)
#   AI_AGENT_WALLET
#   AGENT_WALLET
AI_AGENT_WALLET_ADDRESS=your-new-ai-agent-wallet-public-address

# AI Agent Wallet Secret - Seed phrase or private key (keep this SECRET!)
# Alternative names supported for backward compatibility:
#   AI_AGENT_WALLET_SECRET (recommended)
#   AGENT_WALLET_SECRET
#   AGENT_SEED_PHRASE
#   WALLET_SECRET
AI_AGENT_WALLET_SECRET=your-new-ai-agent-wallet-seed-phrase-or-private-key

# AI Agent Private Key - Base58 or JSON array format private key for on-chain operations
AI_AGENT_PRIVATE_KEY=your-new-ai-agent-private-key

# Treasury Wallet - Receives platform fees and pack purchases
# Alternative names supported for backward compatibility:
#   AI_AGENT_TREASURY_WALLET (recommended)
#   TREASURY_WALLET
#   AGENT_TREASURY
AI_AGENT_TREASURY_WALLET=your-treasury-wallet-public-address

# THC LABZ Swap Wallets
# Alternative names supported:
#   THC_SWAP_MAIN_WALLET (recommended)
#   THC_MAIN_WALLET
THC_SWAP_MAIN_WALLET=your-thc-swap-main-wallet-address

# THC_SWAP_FEE_WALLET can also fall back to AI_AGENT_WALLET_ADDRESS if not set
THC_SWAP_FEE_WALLET=your-thc-swap-fee-wallet-address

# Crossmint Configuration
AI_AGENT_CROSSMINT_WALLET=your-crossmint-wallet-id

# Solana RPC Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Production Settings
NODE_ENV=production
PORT=5000